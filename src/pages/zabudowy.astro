    features: ["100% przestrzeni", "Drzwi przesuwne", "Organizery"]
  },
  {
    title: "Garderoby na wymiar",
    description: "Kompleksowe systemy garderobiane z pełnym wyposażeniem wnętrza",
    image: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/Meble-49.webp",
    features: ["Drążki", "Półki", "Szuflady"]
  },
  {
    title: "Biblioteczki i regały",
    description: "Eleganckie rozwiązania do przechowywania książek i dekoracji",
    image: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/ram2-1_opt.webp",
    features: ["Na wymiar", "Oświetlenie LED", "Różne style"]
  },
  {
    title: "Zabudowy RTV",
    description: "Nowoczesne ścianki pod telewizor z ukrytym okablowaniem",
