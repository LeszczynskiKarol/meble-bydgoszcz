// Features data
const features = [
  {
    icon: "📏",
    title: "Idealne dopasowanie",
    description: "Milimetrowa precyzja w dopasowaniu do ścian, sufitów i podłóg. Wykorzystujemy każdy centymetr dostępnej przestrzeni, nawet w skosach i niszach."
  },
  {
    icon: "🎨",
    title: "Profesjonalny projekt",
    description: "Fotorealistyczna wizualizacja pozwala zobaczyć dokładnie, jak będzie wyglądać zabudowa. Wprowadzamy zmiany aż do pełnej akceptacji projektu."
  },
  {
    icon: "⚙️",
    title: "Materiały premium",
    description: "Stosujemy najlepsze systemy przesuwne i zawiasy z cichym domykaniem. Prowadnice z pełnym wysuwem i dożywotnią gwarancją Blum."
  },
  {
    icon: "💡",
    title: "Inteligentne wnętrza",
    description: "Projektujemy wnętrza z myślą o Twoich potrzebach - organizery, drążki na różnych wysokościach, wysuwane półki, schowki na buty."
  },
  {
    icon: "🛠️",
    title: "Własna produkcja",
    description: "Produkujemy wszystkie elementy w naszej stolarni. Pełna kontrola jakości i możliwość wykonania najbardziej nietypowych projektów."
  },
  {
    icon: "✨",
    title: "Profesjonalny montaż",
    description: "Pewność jakości potwierdzona 5-letnią gwarancją na meble i montaż. Serwis pogwarancyjny przez cały czas użytkowania."
  }
];

// Process steps for builtin
const builtinProcessSteps = [
  {
    number: 1,
    title: "Konsultacja",
    description: "Omawiamy Twoje potrzeby, preferencje i możliwości przestrzenne. Doradzamy optymalne rozwiązania."
  },
  {
    number: 2,
    title: "Pomiar",
    description: "Dokładnie mierzymy przestrzeń z uwzględnieniem wszystkich nierówności ścian, skosów i instalacji."
  },
  {
    number: 3,
    title: "Projekt",
    description: "Tworzymy fotorealistyczny projekt z dokładną wyceną. Możesz wprowadzać dowolne zmiany."
  },
  {
    number: 4,
    title: "Produkcja",
    description: "W naszym zakładzie produkujemy wszystkie elementy zabudowy według projektu. Czas realizacji: kilka tygodni."
  },
  {
    number: 5,
    title: "Montaż",
    description: "Profesjonalny montaż przez doświadczonych montażystów. Precyzyjne dopasowanie i regulacja wszystkich elementów."
  }
];

// Gallery images
const galleryImages: GalleryImage[] = [
  {
    id: "1",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-mdf-lakierowany/ram1-2_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "2",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/Meble-49.webp",
    
    category: "zabudowy"
  },
  {
    id: "3",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/ram2-1_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "4",
    src: "https://www.meblesystem.pl/media/galeria/zest-5_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "5",
    src: "https://media.meblesystem.pl/meblesystem.pl/biura/Biuro-Nieruchomosci-24.webp",
    
    category: "zabudowy"
  },
  {
