    category: "zabudowy"
  },
  {
    id: "8",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/szaf-4_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "9",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-mdf-lakierowany/janlulk-1.webp",
    
    category: "zabudowy"
  },
  {
    id: "10",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/Meble-Wrzesien-166_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "11",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/pigszaf-2_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "12",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-mdf-lakierowany/luk1-2_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "13",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/okol-2.webp",
    
    category: "zabudowy"
  },
  {
    id: "14",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/Meble-Wrzesien-27_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "15",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-mdf-lakierowany/1r-8_opt.webp",
    
    category: "zabudowy"
  },
  {
    id: "16",
    src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/szafsitow-3.webp",
    
    category: "zabudowy"
  },
];

// Reviews data
const reviews = [
  {
    name: "Robert Szymański",
    initials: "RS",
    rating: 5,
    text: "Szafa w przedpokoju idealnie wykorzystuje całą wnękę. Projekt 3D pokazał dokładnie jak będzie wyglądać. Montaż sprawny, wykończenie perfekcyjne. Polecam!",
    date: "Tydzień temu"
  },
  {
    name: "Ewa Zielińska",
    initials: "EZ",
    rating: 5,
    text: "Garderoba wykonana rewelacyjnie! Każdy centymetr wykorzystany, system szuflad i półek dokładnie według moich potrzeb. Okucia wysokiej jakości, wszystko działa płynnie.",
    date: "2 tygodnie temu"
  },
  {
    name: "Marek Kowalski",
    initials: "MK",
    rating: 5,
    text: "Zabudowa RTV z podświetleniem LED wygląda fenomenalnie! Ukryte kable, dużo miejsca na sprzęt, elegancki design. Profesjonalne wykonanie od A do Z.",
    date: "Miesiąc temu"
  }
];

// Fallback reviews dla zabudów
const fallbackBuiltinReviews = [
  {
    id: "builtin-1",
    author: "Robert Szymański",
    avatar: "RS",
    rating: 5,
    text: "Szafa w przedpokoju idealnie wykorzystuje całą wnękę. Projekt 3D pokazał dokładnie jak będzie wyglądać. Montaż sprawny, wykończenie perfekcyjne. Polecam!",
    date: "Tydzień temu",
    verified: true
  },
  {
    id: "builtin-2",
    author: "Ewa Zielińska",
    avatar: "EZ",
    rating: 5,
    text: "Garderoba wykonana rewelacyjnie! Każdy centymetr wykorzystany, system szuflad i półek dokładnie według moich potrzeb. Okucia wysokiej jakości, wszystko działa płynnie.",
    date: "2 tygodnie temu",
    verified: true
  },
  {
    id: "builtin-3",
    author: "Marek Kowalski",
    avatar: "MK",
    rating: 5,
    text: "Zabudowa RTV z podświetleniem LED wygląda fenomenalnie! Ukryte kable, dużo miejsca na sprzęt, elegancki design. Profesjonalne wykonanie od A do Z.",
    date: "Miesiąc temu",
    verified: true
  }
];

let googleReviews = null;
let googleRating = null;
let googleTotalReviews = null;

if (import.meta.env.PROD) {
  try {
    const apiEndpoint = import.meta.env.PUBLIC_REVIEWS_API_ENDPOINT;
    if (apiEndpoint) {
      const response = await fetch(apiEndpoint);
      if (response.ok) {
        const data = await response.json();
        googleReviews = data.reviews;
        googleRating = data.rating;
        googleTotalReviews = data.totalReviews;
      }
    }
  } catch (error) {
    console.error('Failed to fetch Google reviews during build:', error);
  }
}

const displayReviews = googleReviews || fallbackBuiltinReviews;
const displayRating = googleRating || 4.9;
const displayTotalReviews = googleTotalReviews || 127;
---

<BaseLayout title="Zabudowy wnęk na wymiar Bydgoszcz"
description="Chcesz zlecić wykonanie zabudowy na wymiar w Bydgoszczy? Powierz nam to zadanie!"
keywords={[
    "Zabudowy na wymiar Bydgoszcz",    
    "Zabudowy Bydgoszcz",
    "Projektowanie zabudów Bydgoszcz",
    "Montaż i projektowanie zabudów Bydgoszcz",
    "Montaż zabudów Bydgoszcz"
    ]}
>
  <!-- Hero Section -->
  <Hero
    title="Zabudowy na wymiar <span class='highlight'>Bydgoszcz</span>"
    subtitle=""
    description="Maksymalnie wykorzystujemy każdy centymetr Twojej przestrzeni. Szafy wnękowe, garderoby, biblioteczki i zabudowy TV idealnie dopasowane do wnętrza."
    ctaPrimary={{ text: "📞 Darmowa wycena", href: "/kontakt" }}
    ctaSecondary={{ text: "Zobacz realizacje zabudów →", href: "/realizacje#zabudowy" }}
    images={[
      { src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/Kuchnia-10.webp", alt: "Zabudowa wnękowa Bydgoszcz" },
      { src: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/Meble-marzec-17-scaled.webp", alt: "Garderoba na wymiar Bydgoszcz" },
      { src: "https://media.meblesystem.pl/meblesystem.pl/szafy-mdf-lakierowany/ram1-2_opt.webp", alt: "Biblioteczka na wymiar Bydgoszcz" },
      { src: "https://media.meblesystem.pl/meblesystem.pl/szafy-laczone-materialy/Maj-82.webp", alt: "Zabudowa TV Bydgoszcz" }
    ]}
    variant="builtin"
  />

  <!-- Builtin Types Section -->
  <section class="builtin-types">
    <div class="container">
      <div class="section-header">
        <h2>Rodzaje zabudów w naszej ofercie</h2>
        <p>Tworzymy funkcjonalne rozwiązania maksymalnie wykorzystujące dostępną przestrzeń</p>
      </div>
      <div class="builtin-types-grid">
        {builtinTypes.map((type) => (
          <div class="builtin-type-card" style={`background-image: url('${type.image}');`}>
            <div class="builtin-type-content">
              <h3>{type.title}</h3>
              <p>{type.description}</p>
              <div class="builtin-type-features">
                {type.features.map((feature) => (
                  <span>{feature}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <div class="section-header">
        <h2>Dlaczego nasze zabudowy?</h2>
        <p>Maksymalne wykorzystanie przestrzeni z zachowaniem estetyki</p>
      </div>
      <div class="features-grid">
        {features.map((feature) => (
          <div class="feature-card">
            <div class="feature-icon">{feature.icon}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process">
    <div class="container">
      <div class="section-header">
        <h2>Proces realizacji zabudowy</h2>
        <p>Od pomysłu do gotowej realizacji w 5 krokach</p>
      </div>
      <div class="process-grid">
        {builtinProcessSteps.map((step) => (
          <div class="process-card">
            <div class="process-number">{step.number}</div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <Gallery
    title="Nasze realizacje zabudów"
    subtitle="Zobacz zabudowy, które wykonaliśmy dla naszych klientów w Bydgoszczy"
    images={galleryImages}
    viewAllLink="/realizacje#zabudowy"
  />

 <Reviews
  title="Opinie o naszych zabudowach"
  subtitle="Zobacz, co mówią klienci o naszych zabudowach na wymiar"
  fallbackReviews={displayReviews}
  rating={displayRating}
  totalReviews={displayTotalReviews}
  apiEndpoint={import.meta.env.PUBLIC_REVIEWS_API_ENDPOINT}
/>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>Zamów zabudowę na wymiar</h2>
      <p>Zadzwoń lub napisz już teraz i uzyskaj darmową wycenę!</p>
      <div class="cta-buttons">
        <Button
          href="tel:+48576060832"
          variant="primary"
          size="large"
          icon="📞"
        >
          Zadzwoń: 576 060 832
        </Button>
        <Button
          href="/kontakt"
          variant="secondary"
          size="large"
        >
          Napisz do nas
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Builtin Types Section */
  .builtin-types {
    padding: 5rem 5%;
    background: var(--white);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
  }

  .section-header h2::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: var(--secondary-color, #764ba2);
    border-radius: 2px;
  }

  .section-header p {
    font-size: 1.2rem;
    color: var(--text-light, #666);
    max-width: 600px;
    margin: 0 auto;
  }

  .builtin-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 1200px) {
    .builtin-types-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .builtin-types-grid {
      grid-template-columns: 1fr;
    }
  }

  .builtin-type-card {
    position: relative;
    height: 400px;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-size: cover;
    background-position: center;
  }

  .builtin-type-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9),
      rgba(0, 0, 0, 0.2)
    );
    z-index: 1;
    transition: background 0.3s ease;
  }

  .builtin-type-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .builtin-type-card:hover::before {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8),
      rgba(0, 0, 0, 0.1)
    );
  }

  .builtin-type-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    z-index: 2;
    color: var(--white, #ffffff);
  }

  .builtin-type-content h3 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .builtin-type-card:hover .builtin-type-content h3 {
    transform: translateY(-5px);
  }

  .builtin-type-content p {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.95;
  }

  .builtin-type-features {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .builtin-type-features span {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    backdrop-filter: blur(10px);
  }

  /* Features Section */
  .features {
    padding: 5rem 5%;
    background: var(--accent-color, #f4f4f4);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }

  @media (max-width: 1200px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    background: var(--white, #ffffff);
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, #2d5016, #5a8f2d);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .feature-card:hover::before {
    transform: scaleX(1);
  }

  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--white, #ffffff);
  }

  .feature-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--primary-color, #1a1a1a);
  }

  .feature-card p {
    color: var(--text-light, #666);
    line-height: 1.8;
  }

  /* Process Section */
  .process {
    padding: 5rem 5%;
    background: var(--white, #ffffff);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 1200px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 700px;
    }
  }

  @media (max-width: 600px) {
    .process-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }

  .process-card {
    background: var(--white, #ffffff);
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    text-align: center;
    position: relative;
    transition: transform 0.3s ease;
  }

  .process-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .process-number {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #667eea, #764ba2);
