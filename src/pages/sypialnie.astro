---
import Reviews from '../components/sections/Reviews.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Button from '../components/ui/Button.astro';
import Gallery from '../components/sections/Gallery.astro';
import type { GalleryImage } from '../lib/types';

// Bedroom furniture types data
const bedroomTypes = [
  {
    title: "Szafy przesuwne i wnękowe",
    description: "Pojemne szafy maksymalnie wykorzystujące dostępną przestrzeń",
    image: "https://media.meblesystem.pl/meblesystem.pl/szafy-plyta-laminowana/kreta107-2_opt.webp",
    features: ["Na wymiar", "Ciche prowadnice", "LED"]
  },
  {
    title: "Łóżka tapicerowane",
    description: "Eleganckie łóżka z pojemnikiem na pościel i wygodnym zagłówkiem",
    image: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-Tu-29.jpg",
    features: ["Pojemnik", "Różne tkaniny", "Komfort"]
  },
  {
    title: "Komody i szafki nocne",
    description: "Praktyczne rozwiązania do przechowywania z eleganckim designem",
    image: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/1b-3_opt.webp",
    features: ["Soft-close", "Organizacja", "Styl"]
  },
  {
    title: "Toaletki i lustra",
    description: "Stylowe miejsce do makijażu z oświetleniem LED",
    image: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-grudzien-auto-1_opt.webp",
    features: ["LED", "Szuflady", "Elegancja"]
  },
  {
    title: "Garderoby na wymiar",
    description: "Funkcjonalne systemy garderobiane z pełnym wyposażeniem",
    image: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/5CkhYByy8vtnVeyH.jpeg",
    features: ["Organizery", "Drążki", "Półki"]
  },
  {
    title: "Panele i zagłówki",
    description: "Dekoracyjne wykończenia ścian nadające charakter sypialni",
    image: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/IMG_3118.jpg",
    features: ["Tapicerowane", "Metalowe", "LED"]
  }
];

// Features data
const features = [
  {
    icon: "🛏️",
    title: "Wyjątkowy design",
    description: "Tworzymy meble sypialniane o niepowtarzalnym stylu, które dodają przestrzeni wyjątkowego charakteru. Projekty estetycznie dopracowane i w pełni spersonalizowane."
  },
  {
    icon: "🎨",
    title: "Dopasowanie do aranżacji",
    description: "Meble harmonijnie współgrają z całokształtem aranżacji. Tworzymy spójny i estetyczny wystrój idealnie wkomponowany w Twoje przestrzenie."
  },
  {
    icon: "⚙️",
    title: "Personalizacja",
    description: "Dostosowujemy każdy element do Twoich indywidualnych preferencji. Meble na wymiar idealnie odpowiadają Twoim potrzebom i gustom."
  },
  {
    icon: "📐",
    title: "Funkcjonalność",
    description: "Projektowanie i montaż w sposób maksymalnie ułatwiający codzienne funkcjonowanie. Wszystko mieści się wygodnie, gwarantując wysoki komfort."
  },
  {
    icon: "💎",
    title: "Trwałość",
    description: "Najlepsze materiały i profesjonalne wykonanie. Nasze sypialnie na wymiar powstają z myślą o długotrwałej eksploatacji przez wiele lat."
  },
  {
    icon: "🏆",
    title: "Wizualizacja 3D",
    description: "Dokładne zobaczenie jak poszczególne elementy będą wyglądały. Pewność, że prace przebiegną dokładnie tak, jak sobie życzysz."
  }
];

// Process steps for bedrooms
const bedroomProcessSteps = [
  {
    number: 1,
    title: "Konsultacja",
    description: "Indywidualne podejście do każdej realizacji. Omawiamy Twoje potrzeby i oczekiwania estetyczne."
  },
  {
    number: 2,
    title: "Pomiar",
    description: "Dokładne pomiary wnętrza przed wykonaniem prac. Analiza możliwości aranżacji i rozmieszczenia mebli."
  },
  {
    number: 3,
    title: "Projekt 3D",
    description: "Współpraca z projektantem i nanoszenie zmian. Fotorealistyczna wizualizacja z dokładną wyceną."
  },
  {
    number: 4,
    title: "Produkcja",
    description: "Najsolidniejsze materiały i nowoczesne technologie. Precyzyjne wykonanie w naszej stolarni."
  },
  {
    number: 5,
    title: "Montaż",
    description: "Kompleksowy montaż przez wykwalifikowanych specjalistów. Dbałość o każdy detal wykończenia."
  }
];

// Gallery images
const galleryImages: GalleryImage[] = [
  {
    id: "1",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/1a-3_opt-1.webp",
    
    category: "sypialnie"
  },
  {
    id: "2",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Zdjecia-Meble-2025-luty-97-of-175_opt.webp",
    
    category: "sypialnie"
  },
  {
    id: "3",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/1b-2_opt-1.webp",
    
    category: "sypialnie"
  },
  {
    id: "4",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/1a-3_opt-1.webp",
    
    category: "sypialnie"
  },
  {
    id: "5",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-grudzien-auto-2_opt.webp",
    
    category: "sypialnie"
  },
  {
    id: "6",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/lo-2_opt.webp",
    
    category: "sypialnie"
  },
  {
    id: "7",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-Wrzesien-39_opt.webp",
    
    category: "sypialnie"
  },
  {
    id: "8",
    src: "https://www.meblesystem.pl/media/galeria/MEBLE-SYCZEN-45-of-91-scaled.jpg",
    category: "sypialnie"
  },
  {
    id: "9",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/meble-4.jpg",
    category: "sypialnie"
  },
  {
    id: "10",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-17.jpg",
    category: "sypialnie"
  },
  {
    id: "11",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/sypdzie-3.jpg",
    category: "sypialnie"
  },
  {
    id: "12",
    src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/sypdzie-3.jpg",
    category: "sypialnie"
  },
];

// Reviews data
const reviews = [
  {
    name: "Justyna Kowalczyk",
    initials: "JK",
    rating: 5,
    text: "Sypialnia wyszła przepięknie! Szafa na całą ścianę pomieściła wszystkie nasze rzeczy. Łóżko z pojemnikiem to świetne rozwiązanie. Projekt 3D pozwolił nam wszystko dokładnie zaplanować.",
    date: "Tydzień temu"
  },
  {
    name: "Tomasz Majewski",
    initials: "TM",
    rating: 5,
    text: "Profesjonalizm na najwyższym poziomie! Garderoba wykonana idealnie według naszych potrzeb. Systemy cichego domykania działają świetnie. Polecam każdemu!",
    date: "2 tygodnie temu"
  },
  {
    name: "Aleksandra Borkowska",
    initials: "AB",
    rating: 5,
    text: "Nasza sypialnia z Twoich snów stała się rzeczywistością! Jakość mebli rewelacyjna, montaż sprawny i profesjonalny. Tapicerowany zagłówek dodaje elegancji całości.",
    date: "Miesiąc temu"
  }
];

// Fallback reviews dla sypialni
const fallbackBedroomReviews = [
  {
    id: "bedroom-1",
    author: "Justyna Kowalczyk",
    avatar: "JK",
    rating: 5,
    text: "Sypialnia wyszła przepięknie! Szafa na całą ścianę pomieściła wszystkie nasze rzeczy. Łóżko z pojemnikiem to świetne rozwiązanie. Projekt 3D pozwolił nam wszystko dokładnie zaplanować.",
    date: "Tydzień temu",
    verified: true
  },
  {
    id: "bedroom-2",
    author: "Tomasz Majewski",
    avatar: "TM",
    rating: 5,
    text: "Profesjonalizm na najwyższym poziomie! Garderoba wykonana idealnie według naszych potrzeb. Systemy cichego domykania działają świetnie. Polecam każdemu!",
    date: "2 tygodnie temu",
    verified: true
  },
  {
    id: "bedroom-3",
    author: "Aleksandra Borkowska",
    avatar: "AB",
    rating: 5,
    text: "Nasza sypialnia z Twoich snów stała się rzeczywistością! Jakość mebli rewelacyjna, montaż sprawny i profesjonalny. Tapicerowany zagłówek dodaje elegancji całości.",
    date: "Miesiąc temu",
    verified: true
  }
];

let googleReviews = null;
let googleRating = null;
let googleTotalReviews = null;

if (import.meta.env.PROD) {
  try {
    const apiEndpoint = import.meta.env.PUBLIC_REVIEWS_API_ENDPOINT;
    if (apiEndpoint) {
      const response = await fetch(apiEndpoint);
      if (response.ok) {
        const data = await response.json();
        googleReviews = data.reviews;
        googleRating = data.rating;
        googleTotalReviews = data.totalReviews;
      }
    }
  } catch (error) {
    console.error('Failed to fetch Google reviews during build:', error);
  }
}

const displayReviews = googleReviews || fallbackBedroomReviews;
const displayRating = googleRating || 4.9;
const displayTotalReviews = googleTotalReviews || 127;
---

<BaseLayout title="Meble do sypialni na wymiar Bydgoszcz"
description="Chcesz zlecić wykonanie zabudowy na wymiar w Bydgoszczy? Powierz nam to zadanie!"
keywords={[
    "Sypialnie na wymiar Bydgoszcz",    
    "Sypialnie Bydgoszcz",
    "Projektowanie sypialni Bydgoszcz",
    "Montaż i projektowanie sypialni Bydgoszcz",
    "Montaż sypialni Bydgoszcz"
    ]}
>
  <!-- Hero Section -->
  <Hero
    title="Sypialnie na wymiar <span class='highlight'>Bydgoszcz</span>"
    subtitle=""
    description="Tworzymy sypialnie, z których nie chce się wychodzić. Szafy, łóżka, komody i meble sypialniane idealnie dopasowane do Twojej przestrzeni i stylu."
    ctaPrimary={{ text: "📞 Darmowa wycena", href: "/kontakt" }}
    ctaSecondary={{ text: "Zobacz realizacje sypialni →", href: "/realizacje#sypialnie" }}
    images={[
      { src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/1a-3_opt-1.webp", alt: "Nowoczesna sypialnia na wymiar Bydgoszcz" },
      { src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-grudzien-auto-2_opt.webp", alt: "Sypialnia minimalistyczna Bydgoszcz" },
      { src: "https://www.meblesystem.pl/media/galeria/MEBLE-SYCZEN-45-of-91-scaled.jpg", alt: "Sypialnia klasyczna Bydgoszcz" },
      { src: "https://media.meblesystem.pl/meblesystem.pl/sypialnie/Meble-Tu-29.jpg", alt: "Sypialnia z garderobą Bydgoszcz" }
    ]}
    variant="bedroom"
  />

  <!-- Bedroom Types Section -->
  <section class="bedroom-types">
    <div class="container">
      <div class="section-header">
        <h2>Rodzaje mebli do sypialni w naszej ofercie</h2>
        <p>Kompleksowe wyposażenie sypialni dopasowane do Twoich potrzeb i przestrzeni</p>
      </div>
      <div class="bedroom-types-grid">
        {bedroomTypes.map((type) => (
          <div class="bedroom-type-card" style={`background-image: url('${type.image}');`}>
            <div class="bedroom-type-content">
              <h3>{type.title}</h3>
              <p>{type.description}</p>
              <div class="bedroom-type-features">
                {type.features.map((feature) => (
                  <span>{feature}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <div class="section-header">
        <h2>Czym wyróżniają się nasze sypialnie na wymiar?</h2>
        <p>Gwarancja jakości i funkcjonalności na lata</p>
      </div>
      <div class="features-grid">
        {features.map((feature) => (
          <div class="feature-card">
            <div class="feature-icon">{feature.icon}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process">
    <div class="container">
      <div class="section-header">
        <h2>Proces realizacji sypialni</h2>
        <p>Od pierwszego spotkania do gotowej sypialni marzeń</p>
      </div>
      <div class="process-grid">
        {bedroomProcessSteps.map((step) => (
          <div class="process-card">
            <div class="process-number">{step.number}</div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <Gallery
    title="Nasze realizacje sypialni"
    subtitle="Zobacz sypialnie, które stworzyliśmy dla naszych klientów w Bydgoszczy i Toruniu"
    images={galleryImages}
    viewAllLink="/realizacje#sypialnie"
  />

<Reviews
  title="Opinie o naszych sypialniach"
  subtitle="Zobacz, co mówią klienci o naszych meblach do sypialni na wymiar"
  fallbackReviews={displayReviews}
  rating={displayRating}
  totalReviews={displayTotalReviews}
  apiEndpoint={import.meta.env.PUBLIC_REVIEWS_API_ENDPOINT}
/>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>Sypialnia z Twoich snów? Zleć nam wykonanie!</h2>
      <p>Umów się na bezpłatną konsultację i otrzymaj projekt 3D oraz wycenę</p>
      <div class="cta-buttons">
        <Button
          href="tel:+48576060832"
          variant="primary"
          size="large"
          icon="📞"
        >
          Zadzwoń: 576 060 832
        </Button>
        <Button
          href="mailto:kontakt@meblesystem.pl"
          variant="secondary"
          size="large"
        >
          Napisz do nas
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Bedroom Types Section */
  .bedroom-types {
    padding: 5rem 5%;
    background: var(--white);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
  }

  .section-header h2::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: var(--secondary-color, #764ba2);
    border-radius: 2px;
  }

  .section-header p {
    font-size: 1.2rem;
    color: var(--text-light, #666);
    max-width: 600px;
    margin: 0 auto;
  }

  .bedroom-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 1200px) {
    .bedroom-types-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .bedroom-types-grid {
      grid-template-columns: 1fr;
    }
  }

  .bedroom-type-card {
    position: relative;
    height: 400px;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-size: cover;
    background-position: center;
  }

  .bedroom-type-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9),
      rgba(0, 0, 0, 0.2)
    );
    z-index: 1;
    transition: background 0.3s ease;
  }

  .bedroom-type-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .bedroom-type-card:hover::before {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8),
      rgba(0, 0, 0, 0.1)
    );
  }

  .bedroom-type-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    z-index: 2;
    color: var(--white, #ffffff);
  }

  .bedroom-type-content h3 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .bedroom-type-card:hover .bedroom-type-content h3 {
    transform: translateY(-5px);
  }

  .bedroom-type-content p {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.95;
  }

  .bedroom-type-features {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .bedroom-type-features span {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    backdrop-filter: blur(10px);
  }

  /* Features Section */
  .features {
    padding: 5rem 5%;
    background: var(--accent-color, #f4f4f4);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }

  @media (max-width: 1200px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    background: var(--white, #ffffff);
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, #2d5016, #5a8f2d);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .feature-card:hover::before {
    transform: scaleX(1);
  }

  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--white, #ffffff);
  }

  .feature-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--primary-color, #1a1a1a);
  }

  .feature-card p {
    color: var(--text-light, #666);
    line-height: 1.8;
  }

  /* Process Section */
  .process {
    padding: 5rem 5%;
    background: var(--white, #ffffff);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 1200px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 700px;
    }
  }

  @media (max-width: 600px) {
    .process-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }

  .process-card {
    background: var(--white, #ffffff);
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    text-align: center;
    position: relative;
    transition: transform 0.3s ease;
  }

  .process-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .process-number {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: var(--white, #ffffff);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0 auto 1.5rem;
    box-shadow: 0 5px 20px rgba(45, 80, 22, 0.4);
  }

  .process-card h3 {
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .process-card p {
    color: var(--text-light, #666);
    line-height: 1.8;
  }
  

  /* CTA Section */
  .cta-section {
    padding: 5rem 5%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
