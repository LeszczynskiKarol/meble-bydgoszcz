---
// src/pages/blog/kategoria/[category].astro
import { getCollection, type CollectionEntry } from "astro:content";
import Header from "../../../components/layout/Header.astro";
import Footer from "../../../components/layout/Footer.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

type BlogCategory = CollectionEntry<"blog">["data"]["category"];

interface Props {
  categoryName: BlogCategory;
  posts: CollectionEntry<"blog">[];
}

// Funkcja do tworzenia slug z kategorii
function slugify(text: string): string {
  const polishChars: Record<string, string> = {
    'ą': 'a', 'ć': 'c', 'ę': 'e', 'ł': 'l', 'ń': 'n',
    'ó': 'o', 'ś': 's', 'ź': 'z', 'ż': 'z',
    'Ą': 'a', 'Ć': 'c', 'Ę': 'e', 'Ł': 'l', 'Ń': 'n',
    'Ó': 'o', 'Ś': 's', 'Ź': 'z', 'Ż': 'z'
  };
  
  return text
    .toLowerCase()
    .split('')
    .map(char => polishChars[char] || char)
    .join('')
    .replace(/\s+/g, '-');
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  // Funkcja slugify - musi być też tutaj (wewnątrz getStaticPaths)
  function slugify(text: string): string {
    const polishChars: Record<string, string> = {
      'ą': 'a', 'ć': 'c', 'ę': 'e', 'ł': 'l', 'ń': 'n',
      'ó': 'o', 'ś': 's', 'ź': 'z', 'ż': 'z',
      'Ą': 'a', 'Ć': 'c', 'Ę': 'e', 'Ł': 'l', 'Ń': 'n',
      'Ó': 'o', 'Ś': 's', 'Ź': 'z', 'Ż': 'z'
    };
    
    return text
      .toLowerCase()
      .split('')
      .map(char => polishChars[char] || char)
      .join('')
      .replace(/\s+/g, '-');
  }

  // WSZYSTKIE KATEGORIE - musi być WEWNĄTRZ getStaticPaths
  const ALL_CATEGORIES = [
    "Poradniki",
    "Trendy i inspiracje",
    "Materiały i wykończenia",
    "Aranżacje wnętrz",
    "Kuchnie na wymiar",
    "Szafy i garderoby",
    "Łazienki",
    "Sypialnie",
    "Meble biurowe",
    "Wykończenia wnętrz",
    "Realizacje",
    "FAQ",
  ];

  // Buduj strony tylko dla kategorii z min. 1 wpisem — puste kategorie
  // tworzyły thin pages, sieroty w sitemapie (audyt 2026-07-25).
  return ALL_CATEGORIES.filter((category) =>
    posts.some((post) => post.data.category === category)
  ).map((category) => ({
    params: { category: slugify(category) },
    props: {
      categoryName: category,
      posts: posts
        .filter((post) => post.data.category === category)
        .sort(
          (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
        ),
    },
  }));
}

const { categoryName, posts } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("pl-PL", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
};

const getReadingTime = (content: string) => {
  const words = content.split(/\s+/).length;
  return Math.ceil(words / 200);
};

// Opisy kategorii
const categoryDescriptions: Record<string, string> = {
  "Poradniki": "Praktyczne porady dotyczące planowania, projektowania i użytkowania mebli na wymiar.",
  "Trendy i inspiracje": "Najnowsze trendy i style w projektowaniu nowoczesnych mebli.",
  "Materiały i wykończenia": "Wszystko o materiałach: płyty laminowane, MDF lakierowany, akryl, fornir i blaty.",
  "Aranżacje wnętrz": "Inspiracje i pomysły na aranżację wnętrz w różnych stylach.",
  "Kuchnie na wymiar": "Porady i inspiracje dotyczące kuchni na wymiar.",
  "Szafy i garderoby": "Wszystko o szafach wnękowych i garderobiana wymiar.",
  "Łazienki": "Meble łazienkowe na wymiar - porady i inspiracje.",
  "Sypialnie": "Meble do sypialni na wymiar - łóżka, szafy, komody.",
  "Meble biurowe": "Meble biurowe i do domowego biura na wymiar.",
  "Wykończenia wnętrz": "Kompleksowe wykończenia mieszkań i domów.",
  "Realizacje": "Prezentacje naszych najnowszych realizacji mebli na wymiar.",
  "FAQ": "Odpowiedzi na najczęściej zadawane pytania o meble na wymiar.",
};

// Ikony kategorii
const categoryIcons: Record<string, string> = {
  "Poradniki": "📚",
  "Trendy i inspiracje": "✨",
  "Materiały i wykończenia": "🪵",
  "Aranżacje wnętrz": "🎨",
  "Kuchnie na wymiar": "🍳",
  "Szafy i garderoby": "👔",
  "Łazienki": "🚿",
  "Sypialnie": "🛏️",
  "Meble biurowe": "💼",
  "Wykończenia wnętrz": "🏗️",
  "Realizacje": "📸",
  "FAQ": "❓",
};
---

<BaseLayout
  title={`${categoryName} | Blog Meble Bydgoszcz`}
  description={categoryDescriptions[categoryName] || `Artykuły z kategorii ${categoryName}`}
>
  <main class="category-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li>
            <a href="/">Strona główna</a>
          </li>
          <li>/</li>
          <li>
            <a href="/blog">Blog</a>
          </li>
          <li>/</li>
          <li class="current">{categoryName}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="category-header">
        <div class="category-badge">
          <span class="category-icon">{categoryIcons[categoryName] || "📝"}</span>
          <span class="category-label">Kategoria</span>
        </div>
        <h1>{categoryName}</h1>
        <p>{categoryDescriptions[categoryName] || `Wszystkie artykuły z kategorii ${categoryName}`}</p>
        <div class="posts-count">
          {posts.length} {posts.length === 1 ? "artykuł" : posts.length < 5 ? "artykuły" : "artykułów"}
        </div>
      </header>

      {/* Lista artykułów */}
      {posts.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">{categoryIcons[categoryName] || "📝"}</div>
          <p class="empty-title">Artykuły z tej kategorii są w przygotowaniu.</p>
          <p class="empty-subtitle">Wkrótce dodamy treści dotyczące: {categoryName}</p>
          <a href="/blog" class="back-link">
            ← Zobacz dostępne artykuły
          </a>
        </div>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="post-card">
              {post.data.image ? (
                <div class="card-image">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="card-image placeholder">
                  <span>{post.data.title.substring(0, 2).toUpperCase()}</span>
                </div>
              )}
              <div class="card-content">
                <div class="card-date">
                  {formatDate(post.data.publishDate)}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <span class="reading-time">{getReadingTime(post.body || "")} min</span>
                  <span class="read-more">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

      {/* Powrót do bloga */}
      <div class="back-section">
        <a href="/blog" class="back-link">
          ← Wszystkie artykuły
        </a>
      </div>

      {/* CTA Section */}
      <section class="cta-section">
        <h2>Potrzebujesz mebli na wymiar?</h2>
        <p>
          Skontaktuj się z nami i otrzymaj bezpłatną wycenę. Działamy w Bydgoszczy i całym województwie kujawsko-pomorskim.
        </p>
        <a href="/kontakt" class="cta-button">
          Bezpłatna wycena
          <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .category-page {
    padding: 8rem 5% 5rem;
    background: var(--white, #ffffff);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-light, #666);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumbs a {
    color: var(--text-light, #666);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumbs a:hover {
    color: var(--secondary-color, #764ba2);
  }

  .breadcrumbs .current {
    color: var(--primary-color, #1a1a1a);
    font-weight: 500;
  }

  /* Header */
  .category-header {
    margin-bottom: 3rem;
  }

  .category-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .category-icon {
    font-size: 2.5rem;
  }

  .category-label {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
    color: var(--secondary-color, #764ba2);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .category-header h1 {
    font-size: 2.5rem;
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .category-header h1 {
      font-size: 3rem;
    }
  }

  .category-header p {
    font-size: 1.125rem;
    color: var(--text-light, #666);
    max-width: 600px;
  }

  .posts-count {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-light, #666);
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: block;
    background: var(--white, #ffffff);
    border: 1px solid #e5e5e5;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .post-card:hover {
    border-color: var(--secondary-color, #764ba2);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .card-image {
    aspect-ratio: 16/9;
    background: var(--accent-color, #f4f4f4);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-image.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
  }

  .card-image.placeholder span {
    font-size: 2.5rem;
    font-weight: 700;
    color: rgba(118, 75, 162, 0.2);
  }

  .card-content {
    padding: 1.25rem;
  }

  .card-date {
    font-size: 0.75rem;
    color: var(--text-light, #666);
    margin-bottom: 0.75rem;
  }

  .card-content h2 {
    font-size: 1.125rem;
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .post-card:hover .card-content h2 {
    color: var(--secondary-color, #764ba2);
  }

  .card-content p {
    font-size: 0.875rem;
    color: var(--text-light, #666);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  .reading-time {
    color: var(--text-light, #666);
  }

  .read-more {
    color: var(--secondary-color, #764ba2);
    font-weight: 500;
    transition: transform 0.3s ease;
  }

  .post-card:hover .read-more {
    transform: translateX(4px);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--accent-color, #f4f4f4);
    border-radius: 1rem;
  }

  .empty-icon {
    font-size: 3.75rem;
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.125rem;
    color: var(--text-light, #666);
    margin-bottom: 0.5rem;
  }

  .empty-subtitle {
    color: rgba(102, 102, 102, 0.8);
    margin-bottom: 1.5rem;
  }

  /* Back Section */
  .back-section {
    margin-top: 3rem;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary-color, #764ba2);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* CTA Section */
  .cta-section {
    margin-top: 4rem;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.1));
    border-radius: 1rem;
    border: 1px solid rgba(118, 75, 162, 0.1);
    text-align: center;
  }

  .cta-section h2 {
    font-size: 1.5rem;
    color: var(--primary-color, #1a1a1a);
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: var(--text-light, #666);
    margin-bottom: 1.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: var(--white, #ffffff);
    border-radius: 0.75rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(118, 75, 162, 0.3);
  }

  .cta-button .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
